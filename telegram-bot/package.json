{
  "name": "scrumban-telegram-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bot do Telegram + API de inbox/snapshot do Scrumban (Cloudflare Worker + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute scrumban-bot --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute scrumban-bot --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
