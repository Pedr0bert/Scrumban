{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Scrumban",
  "version": "4.1.0",
  "identifier": "com.scrumban.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "dangerousDisableAssetCspModification": ["script-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "category": "Productivity",
    "shortDescription": "Quadro Scrumban pessoal, offline-first",
    "longDescription": "Scrumban Pessoal para desenvolvedores solo: quadro Kanban com sprints, limite WIP, métricas de fluxo (lead time, cycle time, throughput), prazos, subtarefas e backups automáticos. Funciona 100% offline.",
    "copyright": "Copyright © 2026 Pedr0bert — GPL-3.0",
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/Pedr0bert/Scrumban",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "linux": {
      "deb": { "section": "utils" },
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
